# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# If your password contains # or spaces, wrap it in double quotes: DB_PASSWORD="my#pass"
DB_PASSWORD=change_me
DB_NAME=vehiclecare

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# How many days ahead to send "maintenance due soon" reminders
REMINDER_DAYS_AHEAD=3

# ---- AI (optional) ----
# Free key: https://aistudio.google.com/apikey  (sign in with a Google account → Create API key)
# Leave empty to use the built-in rule-based assistant (works offline).
GEMINI_API_KEY=
# Model to use. gemini-3.8-flash is on the free tier and understands photos.
GEMINI_MODEL=gemini-3.8-flash
