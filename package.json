{
  "name": "vehiclecare",
  "version": "1.0.0",
  "description": "VehicleCare - manage parked or unused vehicles and coordinate their maintenance (Node.js, Express, MySQL, PWA)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "check": "node scripts/check.js",
    "test:smoke": "node tests/smoke.js",
    "test:features": "node tests/features.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "leaflet": "^1.9.4",
    "mysql2": "^3.12.0"
  }
}
